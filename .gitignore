# Local reference material (in-game screenshots); never committed
IGNORE/

# Node / Vite
node_modules/
dist/
dist-own/
*.local
.vite/
coverage/

# Playwright browser tests (npm run e2e): results and reports
test-results/
playwright-report/
blob-report/

# Python pipeline scratch and this machine's input paths
pipeline/.cache/
pipeline/paths.local.json
# atomic_write's temp file, left behind only if a run is killed mid-write
*.tmp
__pycache__/
*.pyc
.venv/

# Editors / OS
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# full difference reports (python -m pipeline.compare --effects N): too large to keep
pipeline/report-*-diff-full.md

# checkouts made for a while by tools (tests/corpus/record.mjs) and by agents
.claude/worktrees/

# the local build check's baseline (tests/localbuilds.check.ts): digests of builds only this machine has
.localbuilds/

# the screenshot check's pictures (e2e/screens/screens.spec.ts): they only mean something on the machine that took them
.screens/
